   "fieldname": "scan_section",
   "fieldtype": "Section Break",
   "label": "Mismatch Scan"
  },
  {
   "description": "Only allocations whose <b>payment</b> is dated on or after this date are reported. No payment older than this is ever unreconciled.<br><br>The invoice a payment settles may be older, and often is \u2014 a payment received weeks ago and entered late belongs against whatever is oldest and still open. Re-linking it writes nothing into the older period: no accounting entry is created and the trial balance does not move, only which invoice the payment points at.<br><br>FIFO still reads each customer's FULL history, so the correct allocation is worked out properly. Leave blank to report everything.",
   "fieldname": "scan_from_date",
   "fieldtype": "Date",
   "label": "Report Payments From"
  },
  {
   "default": "1",
   "description": "Scan only customers whose ledger changed since the last completed scan. Much faster for the nightly run. The first run after enabling this still scans everyone.",
   "fieldname": "incremental_scan",
   "fieldtype": "Check",
   "label": "Incremental Scan"
  },

ay}}\n\t\t</div>\n    </div>\n    <div class=\"col-xs-6 column-break\">\n        <div class=\"col-xs-5\">\n\t\t\t<label>Total Deduction</label>\n\t\t</div>\n\t\t<div class=\"col-xs-7 text-right value\">\n\t\t\t{{doc.total_deduction}}\n\t\t</div>\n    </div>\n</div>\n\n<div class=\"row section-break\" data-label=\"\">\n    <div class=\"col-xs-6 column-break\">\n        <div class=\"col-xs-5\">\n\t\t\t<label>Net Pay</label>\n\t\t</div>\n\t\t<div class=\"col-xs-7 text-right value\">\n\t\t\t{{doc.net_pay}}\n\t\t</div>\n    </div>\n    <div class=\"col-xs-6 column-break\">\n        <div class=\"col-xs-5\">\n\t\t\t<label>Rounded Total</label>\n\t\t</div>\n\t\t<div class=\"col-xs-7 text-right value\">\n\t\t\t{{doc.rounded_total}}\n\t\t</div>\n    </div>\n</div>\n\n<div class=\"col-xs-12 column-break\">\n    <div class=\"row  data-field\" data-fieldname=\"total_in_words\" data-fieldtype=\"Data\">\n\t\t<div class=\"col-xs-5\">\n\t\t\t<label>Total in words</label>\n\t\t</div>\n\t\t<div class=\"col-xs-7value\">\n\t\t\t{{doc.base_total_in_words}}\n\t\t</div>\n\t</div>\n            \n<div><hr>\n    <p>System Generated Salary Slip, not Required Company Stamp &amp; Sign</p></div>\n</div>\n<div>\n\n\n<div id=\"footer-html\" class=\"has-variables\">\n    {% if footer and not no_letterhead %}\n    <div id=\"htmlfooter\">\n        {{ footer }}\n    </div>\n    {% endif %}\n</div> \n</div>",

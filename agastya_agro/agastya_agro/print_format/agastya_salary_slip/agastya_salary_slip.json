pe.format(ss.date_of_joining,'Date')}}\n\t\t\t</div>\n\t\t</div>\n    </div>\n    <div class=\"col-xs-4 column-break\" id=\"ab\">\n        <div class=\"row  data-field\" data-fieldname=\"employee\" data-fieldtype=\"Link\">\n\t\t\t<div class=\"col-xs-5\" id=\"abc\">\n\t\t\t\t<label>Start Date</label>\n\t\t\t</div>\n\t\t\t<div class=\"col-xs-7 value\" id=\"abc\">\n\t\t\t\t{{frappe.format(doc.start_date,'Date')}}\n\t\t\t</div>\n\t\t</div>\n    </div>\n    \n</div>\n<div class=\"row section-break\" data-label=\"\">\n     <div class=\"col-xs-4 column-break\" id=\"ab\">\n        <div class=\"row  data-field\" data-fieldname=\"employee\" data-fieldtype=\"Link\">\n\t\t\t<div class=\"col-xs-5\" id=\"abc\">\n\t\t\t\t<label>End Date</label>\n\t\t\t</div>\n\t\t\t<div class=\"col-xs-7 value\" id=\"abc\">\n\t\t\t\t{{frappe.format(doc.end_date,'Date')}}\n\t\t\t</div>\n\t\t</div>\n    </div>\n    <div class=\"col-xs-4 column-break\" id=\"ab\">\n        <div class=\"row  data-field\" data-fieldname=\"employee\" data-fieldtype=\"Link\">\n\t\t\t<div class=\"col-xs-5\" id=\"abc\">\n\t\t\t\t<label>Working Days</label>\n\t\t\t</div>\n\t\t\t<div class=\"col-xs-7 value\" id=\"abc\">\n\t\t\t\t{{doc.total_working_days}}\n\t\t\t</div>\n\t\t</div>\n    </div>\n    \n    <div class=\"col-xs-4 column-break\" id=\"ab\">\n        <div class=\"row  data-field\" data-fieldname=\"employee\" data-fieldtype=\"Link\">\n\t\t\t<div class=\"col-xs-5\" id=\"abc\">\n\t\t\t\t<label>Payment Days</label>\n\t\t\t</div>\n\t\t\t<div class=\"col-xs-7 value\" id=\"abc\">\n\t\t\t\t{{doc.payment_days}}\n\t\t\t</div>\n\t\t</div>\n    </div>\n   \n</div>\n\n<div class=\"row section-break\">\n  <!--  <div class=\"col-xs-4 column-break\">-->\n  <!--      <div class=\"row  data-field\" data-fieldname=\"employee\" data-fieldtype=\"Link\">-->\n\t\t<!--\t<div class=\"col-xs-5\">-->\n\t\t<!--\t\t<label>Leave Without Pay</label>-->\n\t\t<!--\t</div>-->\n\t\t<!--\t<div class=\"col-xs-7 value\">-->\n\t\t<!--\t\t{{doc.leave_withou